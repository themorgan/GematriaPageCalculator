# Baseline ignores — installed once at repo root (INSTALL.md §1).
# Covers ordinary tool/interpreter caches, not generated deliverables.
# Add this repo's generated-deliverable globs below (practice 8) instead of
# replacing this file — merge into an existing .gitignore if one is present.

__pycache__/
*.py[cod]
.DS_Store
*.swp

# Intermediate unpacked build output — regenerate with ./build/build.sh.
# The packaged .zip/.xpi in dist/ are committed as release artifacts.
/dist/chrome/
/dist/firefox/

# From BestPractice templates/gitignore.template (2026-10-01 migration)
.precedent/
.claude/settings.local.json
.claude/worktrees/
