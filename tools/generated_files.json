{
  "_comment": [
    "Every file a tool here writes wholesale: what precedent_check.py's",
    "generated-files-registered checks and what the commit backstop",
    "rebuilds when one of its inputs changes. Never edit those files by",
    "hand: change their sources and let them be rebuilt. This list is",
    "this repository's own."
  ],
  "files": [
    {
      "path": "gotchas/INDEX.md",
      "generated_by": "tools/build_gotcha_index.py",
      "edit_instead": "gotchas/gotcha-*.md",
      "regenerate": "python3 tools/build_gotcha_index.py",
      "check": [
        "tools/build_gotcha_index.py",
        "--check"
      ]
    },
    {
      "path": "todo/CLOSED.md",
      "generated_by": "tools/build_todo_index.py",
      "edit_instead": "todo/todo-*.md",
      "regenerate": "python3 tools/build_todo_index.py",
      "check": [
        "tools/build_todo_index.py",
        "--check"
      ]
    },
    {
      "path": "todo/TODO.md",
      "generated_by": "tools/build_todo_index.py",
      "edit_instead": "todo/todo-*.md",
      "regenerate": "python3 tools/build_todo_index.py",
      "check": [
        "tools/build_todo_index.py",
        "--check"
      ]
    },
    {
      "path": "MAP.md",
      "generated_by": "tools/build_views.py",
      "edit_instead": "MAP.source.md",
      "inputs": [
        "MAP.source.md",
        "MAP.source/*",
        "practices/*.md",
        "*.json"
      ],
      "regenerate": "python3 tools/build_views.py --repo . --views-only",
      "check": [
        "tools/build_views.py",
        "--repo",
        ".",
        "--views-only",
        "--check"
      ]
    },
    {
      "path": "GLOSSARY.md",
      "generated_by": "tools/build_views.py",
      "edit_instead": "GLOSSARY.source.md",
      "inputs": [
        "GLOSSARY.source.md",
        "GLOSSARY.source/*",
        "practices/*.md",
        "*.json"
      ],
      "regenerate": "python3 tools/build_views.py --repo . --views-only",
      "check": [
        "tools/build_views.py",
        "--repo",
        ".",
        "--views-only",
        "--check"
      ]
    }
  ]
}
